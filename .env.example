# =============================================================================
# Opsora SRE Platform — Environment Configuration Template (.env.example)
# Copy this file to .env and configure for your deployment target.
# =============================================================================

# --- 1. Core Application -----------------------------------------------------
APP_NAME="Opsora SRE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- 2. Logging & Diagnostics -----------------------------------------------
# In production on Docker / Render: use LOG_CHANNEL=stderr
# In local development: use LOG_CHANNEL=stack
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- 3. Database Connection --------------------------------------------------
# Option A: PostgreSQL 16 (Render / Neon / Supabase / AWS RDS production)
# Render automatically injects DATABASE_URL from the managed database blueprint.
# DB_CONNECTION=pgsql
# DATABASE_URL=postgres://user:password@host:5432/opsora_sre
#
# Option B: MySQL 8.0+ (Self-hosted / standard LAMP / Docker)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=opsora_sre
DB_USERNAME=root
DB_PASSWORD=

# --- 4. Sessions, Cache & Queue ---------------------------------------------
# On containerized cloud hosts (Render / Vercel), use 'cookie' or 'database'
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- 5. Redis (Optional for high-throughput enterprise caching) -------------
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# --- 6. Email & Notification Dispatch ---------------------------------------
# In local development: use 'log'
# In production: use 'smtp', 'mailgun', 'postmark', or 'ses'
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@your-organization.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- 7. Cloud Storage (AWS S3 / Cloudflare R2 - Optional) --------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# --- 8. Frontend / Vite Assets -----------------------------------------------
VITE_APP_NAME="${APP_NAME}"
